APP_NAME=LyoVial
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

CACHE_CLEAR_TOKEN=lyovial-clear-2026

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lyovial
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
# Laravel 12 uses MAIL_SCHEME (not MAIL_ENCRYPTION).
# Port 465 is often blocked on shared/live hosts (ssl://... connection timed out).
# Use 587 STARTTLS:
MAIL_SCHEME=smtp
MAIL_HOST=mail.privateemail.com
MAIL_PORT=587
MAIL_TIMEOUT=8
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -t -i"
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@lyovial.com"
MAIL_FROM_NAME="${APP_NAME}"
# Contact form inquiry notifications (read via config('mail.contact'), not Laravel alwaysTo)
MAIL_TO_ADDRESS="vlad@evik.ca"
MAIL_TO_NAME="LyoVial"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ9pxH2s
